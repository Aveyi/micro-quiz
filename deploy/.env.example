# Образец deploy/.env — переменных для docker compose. Скопируйте файл в
# deploy/.env и замените значения своими. Сам .env в git НЕ попадает
# (он в .gitignore): в нём настоящие секреты.
#
# Генерировать значения удобно так (только буквы и цифры, длина 64 символа):
#   openssl rand -hex 32
# Буквы и цифры важны: пароль подставляется в адрес БД
# (postgres://пользователь:пароль@хост/...), и символы @ / : # его сломали бы.

# --- PostgreSQL ---
# Пароль суперпользователя postgres. Под ним работают только миграции.
ROOT_PASSWORD=change-me-root-password
# Пароли пользователей сервисов; их создаёт deploy/postgres/init.sh.
LIVE_PASSWORD=change-me-live-password
CONTENT_PASSWORD=change-me-content-password

# --- Общие секреты сервисов ---
# Подпись JWT ведущих: одинаковый у content и live, НЕ КОРОЧЕ 32 байт,
# иначе оба сервиса откажутся стартовать.
JWT_SECRET=change-me-to-64-hex-characters-from-openssl-rand-hex-32
# Ключ внутреннего API content (/internal), заголовок X-Internal-Token.
INTERNAL_TOKEN=change-me-internal-token
